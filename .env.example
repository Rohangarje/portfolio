# Server Configuration
PORT=3000
NODE_ENV=development

# Database Settings
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_database

# Email Integration (Nodemailer Settings)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
CONTACT_RECEIVER=your_receiver_email@example.com

# Session Security Key
SESSION_SECRET=your_secret_session_key
