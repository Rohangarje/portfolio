<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Professional portfolio of Rohan Garje, a final-year Information Technology engineering student. Explore technical skills in Java, Web, AI/ML, academic achievements, and coding logs.">
  <meta name="keywords" content="Rohan Garje, Software Engineer, IT Student, Web Developer, Full Stack Developer, Pune, Indian Developer, Java, Python, AI Eng">
  <meta name="author" content="Rohan Garje">
  <meta name="robots" content="index, follow">
  
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Rohan Garje | Premium Tech Portfolio' %></title>

  <!-- Open Graph Meta Tags (SEO Optimization) -->
  <meta property="og:title" content="Rohan Garje | Final Year IT Engineering student">
  <meta property="og:description" content="Explore Python, JavaScript, Java full-stack skills, AI cheating detector capstones, and coding rankings.">
  <meta property="og:type" content="website">

  <!-- Icons and CSS Stylesheet CDNs -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />
  
  <!-- Main Premium Style -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Manifest for PWA Offline Setup -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#6366f1">

  <!-- Dynamic Theme colors injected automatically from cookies backend -->
  <% if (typeof accentColor !== 'undefined' && accentColor) { %>
    <style>
      :root {
        --accent: <%= accentColor %>;
        --accent-glow: rgba(<%= parseInt(accentColor.substring(1,3), 16) %>, <%= parseInt(accentColor.substring(3,5), 16) %>, <%= parseInt(accentColor.substring(5,7), 16) %>, 0.4);
        --accent-rgb: <%= parseInt(accentColor.substring(1,3), 16) %>, <%= parseInt(accentColor.substring(3,5), 16) %>, <%= parseInt(accentColor.substring(5,7), 16) %>;
      }
    </style>
  <% } %>
</head>
<body class="<%= typeof theme !== 'undefined' && theme === 'light' ? 'light-theme' : '' %>">

  <!-- Dynamic top Progress bar indicator -->
  <div class="scroll-progress"></div>

  <!-- Dynamic Radial Mouse glow spotlight -->
  <div class="spotlight"></div>

  <!-- Custom interactive cursor targets -->
  <div class="custom-cursor"></div>
  <div class="custom-cursor-follower"></div>

  <!-- Creative entrance page preloader -->
  <div class="loader-wrapper">
    <div class="loader-inner" id="loaderTitle">ROHAN GARJE</div>
    <div class="loader-progress">
      <div class="loader-bar"></div>
    </div>
  </div>
